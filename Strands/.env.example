# Copy to .env. All settings use the LEGION_ prefix; nested values use "__".
LEGION_AWS_PROFILE=            # e.g. an eu-west-1 SSO profile
LEGION_AWS_REGION=eu-west-1
LEGION_MODEL_CATALOG__OPUS=eu.anthropic.claude-opus-4-5-20251101-v1:0
LEGION_MODEL_CATALOG__LUNA=    # fill in Luna's Bedrock model / inference-profile id
LEGION_DEFAULT_MODEL=opus
# Per-agent override: alias from the catalog (or a raw model id)
LEGION_AGENT_MODELS__TIM=luna
LEGION_MAX_PARALLEL_AGENTS=3
LEGION_TASK_TIMEOUT_S=300
LEGION_AGENT_TIMEOUTS__DEMIS=600
LEGION_REPO_PATH=              # git repo the workforce writes code into (default: cwd)
LEGION_GITHUB_REPO=CarlitosDev/legion
LEGION_JIRA_BASE_URL=https://efcloud.atlassian.net
LEGION_JIRA_PROJECT=DATA
# Secrets come from the environment only, never state files:
JIRA_EMAIL=
JIRA_API_TOKEN=
